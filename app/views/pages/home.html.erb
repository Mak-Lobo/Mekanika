<% content_for :title, "Admin Dashboard" %>

<div class="mx-auto w-full max-w-7xl space-y-8 py-1 sm:py-10">
  <section class="rounded-3xl border border-cyan-400/20 bg-slate-950 p-6 shadow-xl shadow-black/20 sm:p-10">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div>
        <p class="font-baskerville text-sm font-semibold uppercase tracking-[0.2em] text-cyan-500">Mekanika Garage</p>
        <h1 class="mt-3 text-3xl font-bold text-white sm:text-5xl">Admin dashboard</h1>
        <p class="mt-3 max-w-2xl text-slate-300">Keep an eye on your garage operations, customer activity, and service performance.</p>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= link_to new_service_path, class: "inline-flex items-center gap-2 rounded-lg bg-cyan-500 px-4 py-3 font-semibold text-white transition-all hover:-translate-y-1 hover:bg-cyan-800" do %>
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          <span>Add service</span>
        <% end %>
        <%= link_to services_path, class: "inline-flex items-center gap-2 rounded-lg border border-slate-600 px-4 py-3 font-semibold text-slate-200 transition-all hover:-translate-y-1 hover:border-cyan-400 hover:text-cyan-400" do %>
          <i class="fa-solid fa-wrench" aria-hidden="true"></i>
          <span>View services</span>
        <% end %>
      </div>
    </div>
  </section>

  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    <article class="rounded-2xl border border-cyan-400/20 bg-slate-900 p-5 shadow-lg">
      <div class="flex items-center justify-between">
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-400">Registered users</p>
        <i class="fa-solid fa-users text-cyan-400" aria-hidden="true"></i>
      </div>
      <p class="mt-5 text-3xl font-bold text-white"><%= @total_users %></p>
      <p class="mt-1 text-sm text-slate-400">Live account count</p>
    </article>

    <article class="rounded-2xl border border-cyan-400/20 bg-slate-900 p-5 shadow-lg">
      <div class="flex items-center justify-between">
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-400">Available services</p>
        <i class="fa-solid fa-screwdriver-wrench text-cyan-400" aria-hidden="true"></i>
      </div>
      <p class="mt-5 text-3xl font-bold text-white"><%= @active_services %></p>
      <p class="mt-1 text-sm text-slate-400"><%= @total_services %> total registered</p>
    </article>

    <% @dashboard_metrics.each do |metric| %>
      <article class="rounded-2xl border border-slate-700 bg-slate-900 p-5 shadow-lg">
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold uppercase tracking-wide text-slate-400"><%= metric[:label] %></p>
          <i class="fa-solid <%= metric[:icon] %> text-cyan-400" aria-hidden="true"></i>
        </div>
        <p class="mt-5 text-3xl font-bold text-white"><%= metric[:value] %></p>
        <p class="mt-1 text-sm text-slate-400"><%= metric[:detail] %></p>
      </article>
    <% end %>
  </section>

  <section class="grid gap-6 lg:grid-cols-[1.35fr_1fr]">
    <article class="rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-lg sm:p-8">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.15em] text-cyan-500">Customer voice</p>
          <h2 class="mt-2 text-2xl font-bold text-white">Recent feedback</h2>
        </div>
        <span class="rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs font-semibold text-amber-300">Sample data</span>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <% @recent_feedback.each do |feedback| %>
          <div class="rounded-xl border border-slate-700 bg-slate-950/70 p-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-semibold text-white"><%= feedback[:name] %></p>
                <p class="text-xs text-slate-400"><%= feedback[:vehicle] %></p>
              </div>
              <div class="flex gap-0.5 text-amber-400" aria-label="<%= feedback[:rating] %> out of 5 stars">
                <% feedback[:rating].times do %>
                  <i class="fa-solid fa-star text-xs" aria-hidden="true"></i>
                <% end %>
              </div>
            </div>
            <p class="mt-4 text-sm leading-6 text-slate-300">&ldquo;<%= feedback[:comment] %>&rdquo;</p>
          </div>
        <% end %>
      </div>
    </article>

    <article class="rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-lg sm:p-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.15em] text-cyan-500">Operations</p>
        <h2 class="mt-2 text-2xl font-bold text-white">Recent activity</h2>
      </div>

      <div class="mt-6 space-y-5">
        <% @recent_activity.each do |activity| %>
          <div class="flex gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-cyan-500/10 text-cyan-400">
              <i class="fa-solid <%= activity[:icon] %>" aria-hidden="true"></i>
            </div>
            <div class="min-w-0">
              <p class="font-semibold text-white"><%= activity[:label] %></p>
              <p class="text-sm text-slate-400"><%= activity[:detail] %></p>
              <p class="mt-1 text-xs text-slate-500"><%= activity[:time] %></p>
            </div>
          </div>
        <% end %>
      </div>
    </article>
  </section>

  <section class="rounded-2xl border border-slate-700 bg-slate-900 p-6 shadow-lg sm:p-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.15em] text-cyan-500">Service catalogue</p>
        <h2 class="mt-2 text-2xl font-bold text-white">Availability snapshot</h2>
      </div>
      <%= link_to "Manage all services", services_path, class: "font-semibold text-cyan-400 hover:text-cyan-300 hover:underline" %>
    </div>

    <% if @active_services.zero? %>
      <p class="mt-6 rounded-lg border border-amber-400/20 bg-amber-400/10 p-4 text-amber-200">No active services are currently available.</p>
    <% else %>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <% @active_service_list.each do |service| %>
          <div class="rounded-xl border border-slate-700 bg-slate-950/70 p-4">
            <div class="flex items-center justify-between gap-3">
              <p class="font-semibold text-white"><%= service.name %></p>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-400" title="Active"></span>
            </div>
            <p class="mt-2 text-sm text-slate-400">From KSh <%= number_with_delimiter(service.price.to_i) %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
