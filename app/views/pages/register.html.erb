<div class="mx-auto w-full max-w-2xl py-4">
  <div class="rounded-2xl bg-black-500 p-6 text-white shadow-xl sm:p-10 border border-cyan-400/20">
    <div class="mb-8 justify-center text-center">
      <p class="text-5xl font-bold uppercase text-cyan-600 font-baskerville">Mekanika Garage</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">Create your account</h1>
      <p class="mt-2 text-white">Register to book services and keep your vehicle care organized.</p>
    </div>

    <% if @user&.errors&.any? %>
      <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-red-700" role="alert">
        <p class="font-semibold">Please correct the following errors:</p>
        <ul class="mt-2 list-disc pl-5 text-sm">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: sign_ups_path, class: "space-y-5" do |form| %>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :first_name, "First name", class: "block text-sm font-medium text-white" %>
          <%= form.text_field :first_name, required: true, autofocus: true, autocomplete: "given-name", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
        </div>

        <div>
          <%= form.label :last_name, "Last name", class: "block text-sm font-medium text-white" %>
          <%= form.text_field :last_name, required: true, autocomplete: "family-name", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
        </div>
      </div>

      <div>
        <%= form.label :phone_number, "Phone number", class: "block text-sm font-medium text-white" %>
        <%= form.telephone_field :phone_number, required: true, autocomplete: "tel", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
      </div>

      <div>
        <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-white" %>
        <%= form.email_field :email_address, required: true, autocomplete: "email", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :password, "Password", class: "block text-sm font-medium text-white" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
        </div>

        <div>
          <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-white" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
        </div>
      </div>

      <%= form.submit "Create account", class: "w-full cursor-pointer rounded-md bg-cyan-600 px-4 py-3 font-semibold text-white transition hover:bg-cyan-500" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-600 text-white font-semibold">
      Already have an account?
      <%= link_to "Sign in", new_session_path, class: "font-semibold text-cyan-600 hover:underline" %>
    </p>
  </div>
</div>
