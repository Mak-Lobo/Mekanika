<div class="mx-auto w-full max-w-3xl">
  <div class="mb-4 flex justify-end">
    <%= link_to "Back to Services", services_path, class: "rounded-lg bg-cyan-500 px-4 py-2 font-bold text-white transition-all hover:-translate-y-1 hover:bg-cyan-800" %>
  </div>

  <div class="rounded-2xl border border-cyan-400/20 bg-black-500 p-6 text-white shadow-lg shadow-cyan-500/50 sm:p-10">
    <% if service.errors.any? %>
      <div class="mb-6 rounded-lg border border-red-200 bg-red-700 p-4 text-white" role="alert">
        <h2 class="font-bold text-lg">Please correct the following errors:</h2>
        <ul class="mt-2 list-disc pl-5 text-sm">
          <% service.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: service, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :name, "Service name", class: "block text-md  text-white" %>
        <%= form.text_field :name, required: true, autofocus: true, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-white text-xs shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
      </div>

      <div>
        <%= form.label :description, "Service description", class: "block text-md text-white" %>
        <%= form.text_area :description, required: true, rows: 5, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-white text-xs shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
      </div>

      <div>
        <%= form.label :price, "Service price (KSh)", class: "block text-md text-white" %>
        <%= form.number_field :price, required: true, min: 0, step: 10.00, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-white text-xs shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
      </div>

      <% if service.persisted? %>
        <div class="flex items-center justify-between rounded-lg border border-slate-700 bg-slate-900/60 px-4 py-3">
          <div>
            <%= form.label :active, "Service availability", class: "block text-md text-white" %>
            <p class="text-xs text-slate-400">Show this service to customers.</p>
          </div>

          <label class="relative inline-flex cursor-pointer items-center">
            <%= form.check_box :active, class: "peer sr-only" %>
            <span class="h-6 w-11 rounded-full bg-slate-600 transition-colors after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-slate-300 after:bg-white after:transition-transform after:content-[''] peer-checked:bg-cyan-500 peer-checked:after:translate-x-full peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-cyan-500"></span>
          </label>
        </div>
      <% end %>

      <%= form.submit class: " flex w-full justify-self-end cursor-pointer rounded-md bg-cyan-500 px-4 py-3 font-semibold text-white transition-all hover:-translate-y-1 hover:bg-cyan-800 hover:shadow-lg hover:shadow-cyan-500/50 sm:w-auto" %>
    <% end %>
  </div>
</div>
