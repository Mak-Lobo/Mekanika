<% if @service.errors.any? %>
      <div class="bg-gray-300 text-red-600 p-4 rounded-lg mb-4 flex flex-col justify-center items-center">
        <h2 class="font-bold text-lg">Error(s) occurred:</h2>
        <ul class="list-disc list-inside">
          <% @service.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>   

  <div class="mx-auto w-3/4">
    <%# Back to the index page %>
  <div class="flex justify-end items-center mt-2">
    <%= link_to "Back to Services", services_path, class: " w-auto mt-2  bg-blue-500 hover:bg-blue-700 text-    white font-bold py-2 px-4 rounded" %>
  </div>
  <hr class="my-4 border-gray-400">

    <%= form_with model: @service, class: "border rounded-lg p-2 bg-black text-gray-300 font-['Times'] flex flex-row justify-evenly" do |form| %>
    <div class="flex space-x-16 border border-blue-600">
        <div class='flex-1'>
            <%= form.label :name, "Service Name" %><br>
            <%= form.text_field :name, class: "border rounded-lg h-10" %>
        </div>
        <div class='flex-1'>
            <%= form.label :description, "Service Description" %><br> 
            <%= form.text_area :description, class: "border rounded-lg min-h-16" %>
        </div>
        <div>
            <%= form.label :price, "Service Price" %><br>
            <%= form.number_field :price, step: 0.01, class: "border rounded-lg h-10" %>
        </div>
        <br>
    </div>
    <div class="flex items-center justify-flex-end">
      <%= form.submit class: "border rounded-md bg-gray-500 text-gray-300 hover:bg-gray-700 px-4 py-2" %>
    </div>
  </div>
  <% end %>
  