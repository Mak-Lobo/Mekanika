<% active = local_assigns.fetch(:active) %>
<% base_classes = "rounded-md px-4 py-2 transition" %>
<% inactive_classes = "text-slate-300 hover:bg-slate-800 hover:text-cyan-400" %>
<% active_classes = "bg-cyan-500 text-white" %>

<div class="flex flex-col items-center justify-center text-sm font-semibold text-slate-300">
    <p class="text-xl font-bold text-white">Settings</p>
    <div class="flex flex-col items-center justify-center gap-1 mb-3">
      <p class="text-sm text-white">Manage your account settings and preferences.</p>
      <span class="text-sm text-white">Email: <%= Current.user.email_address %></span>
    </div>
    
  <nav class="mb-8 flex flex-wrap justify-center gap-2 border-b border-slate-700 pb-4 text-sm font-semibold" aria-label="Settings">
    <%= link_to "Profile", settings_profile_path, class: "#{base_classes} #{active == :profile ? active_classes : inactive_classes}" %>
    <%= link_to "Password", settings_password_path, class: "#{base_classes} #{active == :password ? active_classes : inactive_classes}" %>
    <%= link_to "Email", settings_email_path, class: "#{base_classes} #{active == :email ? active_classes : inactive_classes}" %>
  </nav>
</div>