<% content_for :title, "Profile Settings" %>

<div class="mx-auto w-full max-w-2xl py-8">
  <div class="rounded-2xl border border-cyan-400/20 bg-black-500 p-6 text-white shadow-xl sm:p-10">
    <div class="mb-8 text-center">
      <p class="font-baskerville text-sm font-semibold uppercase tracking-[0.2em] text-cyan-500">Mekanika Garage</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">Profile settings</h1>
      <p class="mt-2 text-slate-300">Keep your personal details up to date.</p>
    </div>

    <%= render "settings/nav", active: :profile %>

    <%= form_with model: Current.user, url: settings_profile_path, id: "profile-form", class: "space-y-5" do |form| %>
      <% if form.object.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-700 p-4 text-white" role="alert">
          <p class="font-semibold">Please correct the following errors:</p>
          <ul class="mt-2 list-disc pl-5 text-sm">
            <% form.object.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :first_name, "First name", class: "block text-sm font-medium text-white" %>
          <%= form.text_field :first_name, required: true, autocomplete: "given-name", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-white shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
        </div>

        <div>
          <%= form.label :last_name, "Last name", class: "block text-sm font-medium text-white" %>
          <%= form.text_field :last_name, required: true, autocomplete: "family-name", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-white shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
        </div>

        <div>
          <%= form.label :phone_number, "Phone number", class: "block text-sm font-medium text-white" %>
          <%= form.telephone_field :phone_number, required: true, autocomplete: "tel", placeholder: "+254 700 000 000", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-white shadow-sm focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600" %>
        </div>
      </div>

    <% end %>

    <div class="mt-5 flex flex-col justify-evenly gap-3 sm:flex-row sm:items-center">
      <%= button_tag "Update profile", type: "submit", form: "profile-form", class: "w-full cursor-pointer rounded-md bg-cyan-500 px-4 py-3 font-semibold text-white transition-all hover:-translate-y-1 hover:bg-cyan-800 hover:shadow-lg hover:shadow-cyan-500/50 sm:w-auto" %>
      <%= button_to "Delete account", settings_profile_path, method: :delete, form_class: "w-full sm:w-auto", data: { turbo_confirm: "Are you sure you want to permanently delete your account?" }, class: "w-full cursor-pointer rounded-md border border-red-500 px-4 py-3 font-semibold text-red-400 transition-all hover:-translate-y-1 hover:bg-red-600 hover:text-white hover:shadow-lg hover:shadow-red-500/50 sm:w-auto" %>
    </div>
  </div>
</div>
