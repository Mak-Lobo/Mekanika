<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Mekanika" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="Mekanika">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
  <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%# Includes all stylesheet files in app/assets/stylesheets %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <!-- Font Awesome link  -->
  <script src="https://kit.fontawesome.com/2b0c10265f.js" crossorigin="anonymous"></script><!--  -->
</head>

<body class="bg-slate-800 text-white font-sans flex flex-col min-h-screen">
<header class="flex items-center justify-between bg-gray-900 text-white px-2 py-2 shadow-md shadow-slate-500/50 mb-4">
  <h1 class="text-5xl font-bold uppercase font-syne mt-4"><%= Mekanika %></h1>
  <nav class="flex items-center align-middle justify-end bg-gray-900 text-white p-4">
    <ul class="flex gap-4 p-4 font-semibold text-lg font-inter">
      <li><%= link_to "Home", home_path, class: "hover:text-gray-400 hover:underline" %></li>
      <li><%= link_to "About", about_path, class: "hover:text-gray-400 hover:underline" %></li>
      <li class="group relative">
        <%= link_to settings_profile_path, class: "inline-flex items-center rounded-full border border-transparent hover:px-2 hover:py-1 text-white transition-all duration-300 ease-out hover:-translate-y-2 hover:border-white hover:bg-slate-800 hover:text-gray-400 hover:underline hover:shadow-md hover:shadow-red-500/20", aria: { label: "Open account menu" } do %>
          <i class="fa-solid fa-circle-user" aria-hidden="true"></i>
          <span>Account</span>
        <% end %>
        <div class="invisible absolute right-0 top-full z-50 min-w-50 translate-y-1 pt-2 opacity-0 transition-all duration-300 ease-out group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
          <div class="rounded-xl border border-cyan-400/20 bg-gray-900 p-2 shadow-xl shadow-black/30">

            <% if authenticated? %>
              <%= link_to settings_root_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-white transition hover:bg-slate-800 hover:text-cyan-400" do %>
                <i class="fa-solid fa-gear" aria-hidden="true"></i>
                <span>Settings</span>
              <% end %>

              <%= button_to session_path, method: :delete, form_class: "block", class: "flex w-full cursor-pointer items-center gap-2 rounded-lg bg-transparent px-3 py-2 text-left text-sm text-white transition hover:bg-slate-800 hover:text-cyan-400" do %>
                <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                <span>Log out</span>
              <% end %>
            <% else %>
              <%= link_to signup_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-white transition hover:bg-slate-800 hover:text-cyan-400" do %>
                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                <span>Sign Up</span>
              <% end %>

              <%= link_to new_session_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-white transition hover:bg-slate-800 hover:text-cyan-400" do %>
                <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
                <span>Login</span>
              <% end %>
            <% end %>
          </div>
        </div>
      </li>
    </ul>
  </nav>
</header>
<main class="w-full px-2 flex-1 font-inter">
  <%= yield %>
</main>
<%# Footer %>
<footer class="bg-gray-900 text-white p-4 mt-10">
  <div class="flex flex-col text-center items-end justify-items-start">
    <p class="text-sm text-gray-400">Mekanika is a fictional garage created for educational purposes.</p>
    <p class="text-sm text-gray-400">All content is for demonstration only and does not represent a real business.</p>
  </div>
  <div class="container mx-auto text-center">
    <p>&copy; <%= Time.current.year %> Mekanika. All rights reserved.</p>
  </div>
</footer>
</body>
</html>
