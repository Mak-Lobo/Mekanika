<div class="w-full flex flex-col justify-center items-center">
  <h1 class="font-bold text-4xl">Registered Services</h1>
  <br>

  <div class="flex justify-end items-center mb-4">
    <%= link_to "Create New Service", new_service_path, class: " font-semibold border rounded-md bg-cyan-700 text-slate-200 hover:bg-cyan-500 hover:text-black p-1 flex justify-center items-end transition-all duration-200 ease-in-out hover:shadow-md hover:shadow-cyan-500 hover:-translate-y-0.5" %>
  </div>
  <%# empty service list %>
  <% if @services.empty? %>
    <div class="bg-gray-300 text-red-600 p-4 rounded-lg mb-4 flex justify-center items-center w-full">
      <h2 class="font-bold text-lg">No services found.</h2>
    </div>
  <% else %>

  <%# Showing all services through a table %>
  <table class="border border-cyan-500 w-7/8">
    <thead>
      <tr class="bg-slate-800 text-white">
        <th class="border border-black p-2">ID</th>
        <th class="border border-black p-2">Name</th>
        <th class="border border-black p-2">Description</th>
        <th class="border border-black p-2">Average price</th>
        <th class="border border-black p-2">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @services.each do |service| %>
        <tr class="bg-slate-600 text-white">
          <td class="border border-black p-1.5"><%= service.id %></td>
          <td class="border border-black p-1.5"><%= service.name %></td>
          <td class="border border-black p-1.5"><%= service.description %></td>
          <td class="border border-black p-1.5"><%= service.price %></td>
          <td class="border border-black p-1.5">
            <div class="flex space-x-2">
            <%= link_to "Show", service_path(service), 
    class: "inline px-1.5 border border-transparent rounded-md text-blue-500 font-medium transition-all duration-200 ease-in-out hover:underline hover:text-blue-700 hover:bg-blue-200 hover:border-blue-500 hover:-translate-y-0.5" %>
              <%= link_to "Edit", edit_service_path(service), 
    class: "inline px-1.5 border border-transparent rounded-md text-black font-medium transition-all duration-200 ease-in-out hover:underline hover:text-white hover:bg-cyan-500 hover:border-cyan-200 hover:-translate-y-0.5" %>
              <%= link_to "Delete", service_path(service), method: :delete, data: { turbo_method: :delete, turbo_confirm: "Are you sure you wish to delete this service?" }, 
    class: "inline-block px-1.5 border border-transparent rounded-md text-red-500 font-medium transition-all duration-200 ease-in-out hover:underline hover:text-red-700 hover:bg-red-200 hover:border-red-500 hover:-translate-y-0.5" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% end %>
</div>
